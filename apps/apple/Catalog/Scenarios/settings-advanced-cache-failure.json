{
  "id": "settings.advanced.cache-failure",
  "extends": "settings.advanced",
  "title": "Advanced Settings · temporary-file cleanup failure and retry",
  "expect": [
    "Clear Now shows the localized storage failure as plain failure-coloured text in the temporary-files group footer.",
    "Clear Now again succeeds, restores the normal explanation and updates the size. No separate Retry action appears; thumbnails remain independent."
  ],
  "actions": [
    {
      "action": "Press Clear Now.",
      "result": "The temporary-files footer shows the localized failure reason."
    },
    {
      "action": "Press Clear Now again.",
      "result": "The second scripted reclaim succeeds; the normal footer returns and the size decreases by 1 MiB."
    }
  ],
  "core": {
    "reclaim_sender_cache": [
      {
        "error": "storage",
        "delay": 1
      },
      {
