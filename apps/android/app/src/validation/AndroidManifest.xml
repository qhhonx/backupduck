<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider android:name=".ValidationScanTransport" android:authorities="${applicationId}.testscan" android:exported="false" />
        <!-- Only adb shell holds DUMP, so no installed app can inject a scan result. -->
        <receiver android:name=".ValidationScanReceiver" android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
